            "dataType": "dateTime",
            "sourceColumn": "signup_date",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy"
          }
        ],
        "partitions": [
          {
            "name": "DimCustomers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database),",
                "    Data = Source{[Schema=\"retail\", Item=\"customers\"]}[Data],",
                "    Typed = Table.TransformColumnTypes(Data, {{\"signup_date\", type date}})",
                "in",
                "    Typed",
