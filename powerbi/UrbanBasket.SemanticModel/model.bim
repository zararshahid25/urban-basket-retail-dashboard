        "name": "relationship_0",
        "fromTable": "FactSales",
        "fromColumn": "product_id",
        "toTable": "DimProducts",
        "toColumn": "product_id",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "relationship_1",
        "fromTable": "FactSales",
