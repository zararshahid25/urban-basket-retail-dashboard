            "sourceColumn": "list_price",
            "summarizeBy": "none"
          },
          {
            "name": "active_flag",
            "dataType": "boolean",
            "sourceColumn": "active_flag",
            "summarizeBy": "none"
          },
          {
            "name": "category_name",
            "dataType": "string",
            "sourceColumn": "category_name",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimProducts",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database),",
                "    Data = Source{[Schema=\"retail\", Item=\"dim_products\"]}[Data]",
                "in",
                "    Data",
                ""
              ]
            }
          }
        ]
      },
      {
        "name": "DimCustomers",
        "columns": [
          {
