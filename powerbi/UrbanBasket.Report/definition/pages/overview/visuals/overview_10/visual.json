            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactSales"
                    }
                  },
                  "Property": "Sales MoM Change"
                }
              },
              "queryRef": "FactSales.Sales MoM Change"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly change in net sales'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#195A43'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
